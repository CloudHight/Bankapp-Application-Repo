<?xml version="1.0" encoding="UTF-8"?>
<!--
  Approved exceptions for the OWASP Dependency-Check gate.
  Every entry needs a matching row in security/EXCEPTIONS.md and an "until" date.
  After that date the entry stops applying and the build fails again.

  Example:

  <suppress until="2026-12-15Z">
    <notes>EX-001. Owner: name. Why: reason. Jira: CT-00.</notes>
    <packageUrl regex="true">^pkg:maven/com\.example/library@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
