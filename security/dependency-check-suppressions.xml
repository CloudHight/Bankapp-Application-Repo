<?xml version="1.0" encoding="UTF-8"?>
<!--
  Approved exceptions for the OWASP Dependency-Check gate.
  Every entry needs a matching row in security/EXCEPTIONS.md and an "until" date.
  After that date the entry stops applying and the build fails again.

  Example:

  <suppress until="2026-12-15Z">
    <notes>EX-001. Owner: name. Why: reason. Jira: CT-00.</notes>
    <packageUrl regex="true">^pkg:maven/com\.example/library@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <suppress until="2026-12-26Z">
    <notes>EX-001. Owner: Kim. Why: false positive - CVE targets Angus Mail (SMTP), matched to angus-activation via low-confidence CPE; app sends no email. Jira: CT-45.</notes>
    <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
    <cve>CVE-2025-7962</cve>
  </suppress>
</suppressions>
