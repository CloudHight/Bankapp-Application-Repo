pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Trivy Secret Scan') {
            steps {
                sh 'trivy fs --scanners secret --skip-files "**/pom.xml" --exit-code 1 --debug .'
            }
        }
    }
}

